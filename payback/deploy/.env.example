# Copie para .env (nesta pasta) e preencha. O .env nunca vai para o Git.

# Domínio do portal, sem https://.
DOMAIN=payback.informo.com.br

# Senha do banco. Use só letras e números, por exemplo: openssl rand -hex 24
POSTGRES_PASSWORD=

# Login pelo Microsoft Entra ID (registro "Informo Payback Portal").
ENTRA_TENANT_ID=9899089d-c6d4-4e00-b2e9-ff7e1fc5141a
ENTRA_CLIENT_ID=6d173aa0-39b2-46cc-b6c0-7074f18d26be
# Valor do segredo criado em "Certificados e segredos". Guarde só aqui.
ENTRA_CLIENT_SECRET=

# E-mails promovidos a administrador ao entrar, separados por vírgula.
ADMIN_EMAILS=marcio@informo.com.br

# Duração máxima da sessão, em horas (1 a 168).
SESSION_HOURS=12

# Só com o Caddy (--profile caddy): e-mail para avisos do Let's Encrypt.
ACME_EMAIL=marcio@informo.com.br

# Porta local da aplicação, para um proxy reverso já existente.
APP_PORT=8080

# Backup diário: hora (0 a 23, horário de Brasília), dias mantidos e pasta.
BACKUP_HOUR=2
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=./backups

# Só se o servidor sai para a internet por um proxy corporativo, por exemplo
# http://proxy.informo.local:3128. Em branco, a saída é direta.
HTTPS_PROXY=

# Versão da imagem; use a revisão do Git para saber o que está no ar.
VERSION=dev
