# Copie para .env e preencha. O .env nunca vai para o Git.

# Banco PostgreSQL.
DATABASE_URL=postgres://payback:TROQUE@127.0.0.1:5432/payback

# Endereço em que o servidor escuta e endereço visto pelo navegador.
LISTEN_ADDR=127.0.0.1:8080
PUBLIC_URL=https://payback.informo.com.br

# Login pelo Microsoft Entra ID (registro "Informo Payback Portal").
ENTRA_TENANT_ID=9899089d-c6d4-4e00-b2e9-ff7e1fc5141a
ENTRA_CLIENT_ID=6d173aa0-39b2-46cc-b6c0-7074f18d26be
# Valor do segredo criado em "Certificados e segredos". Guarde só aqui.
ENTRA_CLIENT_SECRET=

# Duração máxima da sessão, em horas (1 a 168).
SESSION_HOURS=12

# E-mails promovidos a administrador ao entrar, separados por vírgula.
ADMIN_EMAILS=marcio@informo.com.br

# Somente desenvolvimento local, sem login. Não pode ser combinado com ENTRA_*
# e só funciona com LISTEN_ADDR em localhost.
# DEV_USER_EMAIL=voce@informo.com.br
